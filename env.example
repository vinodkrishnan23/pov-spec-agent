# Same env-var contract as pov-builder's own .env.example — this project
# reuses pov-builder's config/settings.py, tools/git_repo.py, and
# tools/mongo_store.py as-is.

# LLM — OpenAI-compatible (direct OpenAI, or Grove's proxy).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=

# GitHub — spec_architect commits every contract (data_model.json,
# query_patterns.json, api_contract.json, frontend_contract.json,
# requirements.json) to this repo, on a branch named
# "<email-slug>/<pov_name-slug>". Must be the SAME repo the full
# pov-builder pipeline uses downstream for code generation.
GITHUB_ORG=
GITHUB_USERNAME=
GITHUB_TOKEN=
GITHUB_REPO=pov-builder

# MongoDB Atlas — pov_builder_runs run ledger (MongoPovRunStore). The
# LangGraph checkpointer itself comes from Magenta's app.checkpointer(),
# not this URI directly, but should point at the same cluster so a run
# started here is visible to the same downstream tooling.
MONGODB_URI=
MONGODB_DB=pov_builder

LOG_LEVEL=INFO
